# Variables d'environnement du site. Une copie remplie par environnement :
#   - en local : .env.local
#   - staging   : secret GitHub ENV_FILE_PREPROD
#   - prod      : secret GitHub ENV_FILE_PROD
# Lues au build (NEXT_PUBLIC_*, SITE_ENV) et à l'exécution (SMTP_*).

# URL publique du site, sans barre finale (balises canoniques, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://staging.feretfeu.fr

# production = indexé par Google ; toute autre valeur (preprod) = noindex partout
SITE_ENV=preprod

# Envoi du formulaire de devis (Gmail : mot de passe d'application, pas le mot de passe du compte)
SMTP_USER=adresse@gmail.com
SMTP_PASS=mot-de-passe-d-application
SMTP_MAIL_TO=adresse-qui-recoit-les-devis@exemple.fr
# Facultatif : par défaut smtp.gmail.com sur le port 465
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
