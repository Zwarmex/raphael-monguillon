# Secrets GitHub Actions du déploiement (repo Zwarmex/raphael-monguillon).
# Copier en github-secrets.env (ignoré par git), remplir, puis lancer :
#   .\scripts\github-secrets.ps1 -DryRun   (vérifier)
#   .\scripts\github-secrets.ps1           (envoyer)
#
# NOM=valeur  |  NOM=@chemin (contenu d'un fichier)  |  NOM= (vide = on ne touche pas)
#
# Mêmes noms que norde.be : si le staging tourne sur le même serveur, les valeurs
# Tailscale et SSH sont les mêmes.

# Tailscale OAuth (console Tailscale > Settings > OAuth clients, tag:github-actions)
TS_OAUTH_CLIENT_ID=
TS_OAUTH_SECRET=

# Utilisateur / port SSH (identiques sur les serveurs de prod et de staging)
SSH_USER=deploy
SSH_PORT=22222

# Staging (branche staging) : host = nom MagicDNS ou IP Tailscale
DEV_SSH_HOST=
# Clé privée "Github->..." exportée de Vaultwarden dans un fichier
DEV_SSH_KEY=@

# Variables du site en staging : un fichier au format de .env.example
ENV_FILE_PREPROD=@

# Prod (branche master), à remplir quand la prod sera ouverte
SSH_HOST=
SSH_KEY=@
ENV_FILE_PROD=@
